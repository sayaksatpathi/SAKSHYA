# =============================================================================
# SAKSHYA — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit the real .env file to version control.
# =============================================================================

# --- Application ---
SAKSHYA_VERSION=0.1.0
SAKSHYA_ENV=development
SAKSHYA_DEBUG=true
SAKSHYA_HOST=0.0.0.0
SAKSHYA_PORT=8000
SAKSHYA_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# --- Database ---
DATABASE_URL=sqlite:///./storage/sakshya.db

# --- Storage ---
EVIDENCE_STORAGE_PATH=./storage/evidence
EXPORT_STORAGE_PATH=./storage/exports
TEMP_STORAGE_PATH=./storage/temp

# --- AI Models ---
MODEL_BASE_PATH=./models
SAKSHYA_AI_MODE=real        # real | demo — "real" uses actual model inference; "demo" uses synthetic results
DETECTION_CONFIDENCE=0.35
YOLO_IOU=0.45
FRAME_SAMPLE_RATE=5
MAX_ANALYSIS_FRAMES=0       # 0 = unlimited
MAX_VIDEO_DURATION=3600
MAX_UPLOAD_SIZE=2147483648

# --- Trust Service ---
TRUST_SERVICE_URL=http://localhost:8001
TRUST_AUTHORITY_ID=SAKSHYA-TRUST-PROTOTYPE-001

# --- Trust Service (for the trust_service process itself) ---
# TRUST_PRIVATE_KEY_PATH=./trust_service/keys/private.pem
# TRUST_PUBLIC_KEY_PATH=./trust_service/keys/public.pem
# TRUST_HMAC_SECRET=CHANGE_ME_TO_A_RANDOM_HMAC_SECRET

# --- Authentication (simple demo) ---
DEFAULT_INVESTIGATOR=Demo Investigator
DEFAULT_INVESTIGATOR_ROLE=Lead Investigator
DEFAULT_INVESTIGATOR_ID=INV-001

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
